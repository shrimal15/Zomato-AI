# Copy to .env and fill in your key. .env is not committed.
# Without GROQ_API_KEY, ranking falls back to catalog facts and no AI explanation.

GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# Browser origins allowed to call the API, comma-separated.
# On Render, set this to the Vercel URL, for example https://your-app.vercel.app
FRONTEND_ORIGIN=http://127.0.0.1:3000
